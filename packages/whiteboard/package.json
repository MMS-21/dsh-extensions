{
  "name": "@local/dsh-plugin-whiteboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An agentic whiteboard for DeepSeek Harness: a canvas of notes, groups, routes and stickers, with chat tools that read the board and propose changes.",
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "PORTING.md",
    "VERIFICATION.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "dependencies": {
    "zod": "^3.25.76 || ^4.0.0"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "playwright-core": "1.65.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
