{
  "name": "@local/dsh-plugin-powerbi-live-designer",
  "version": "0.6.1",
  "private": true,
  "description": "Power BI authoring with exact user-approved changes, guarded canvas reload and verified affected-table data refresh.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "skills.js",
    "skills/**",
    "SKILLS-SOURCE.md",
    "py-service/*.py",
    "start-coordinator.ps1",
    "LICENSE.skills",
    "design-contracts.js",
    "microsoft-mcp.mjs",
    "model-validator.mjs",
    "model-refresh.mjs",
    "direct-model.mjs",
    "desktop-binding.mjs",
    "task-store.mjs",
    "workflow.mjs",
    "prepare-project.mjs",
    "project-snapshot.mjs",
    "save-project.mjs",
    "setup-save.ps1",
    "requirements-save.txt",
    "SIMPLIFICATION-PLAN.md",
    "tool-json.mjs",
    "draft-input.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:python": "python -B -m unittest discover -s py-service/tests -v",
    "test:dsh-json": "node tests/dsh-json-runtime.mjs"
  },
  "dependencies": {
    "@microsoft/powerbi-report-authoring-cli": "0.5.0"
  },
  "optionalDependencies": {
    "@microsoft/powerbi-modeling-mcp-win32-x64": "1.0.1"
  }
}
